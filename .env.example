# ── Strava API ─────────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ── OAuth micro-app (port 2025) ────────────────────────────
OAUTH_REDIRECT_URI=https://strava-coach.duckdns.org/auth/callback
TOKENS_DIR=/home/nicee/stravbike/data/tokens

# ── Base de données multi-utilisateur ──────────────────────
DATABASE_URL=postgresql://postgres@localhost/db_multi_stravbike

# ── Auth service key (X-API-Key) ───────────────────────────
STRAVBIKE_SERVICE_KEY=

# ── Session secret (HMAC signing) ──────────────────────────
SESSION_SECRET=

# ── PayPal ──────────────────────────────────────────────────
PAYPAL_URL=https://paypal.me/NiceeCap

# ── LLM (OpenRouter) ───────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# ── Modèles par défaut par niveau (optionnel) ──────────────
# LLM_FREE_DEFAULT=nepothos/nemotron-mini-4b-instruct:free
# LLM_SUPPORTER_DEFAULT=moonshotai/kimi-k2:free
# LLM_DONOR_DEFAULT=openai/gpt-4o
