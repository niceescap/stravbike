# ── Strava API ─────────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ── Base de données ────────────────────────────────────────
DATABASE_URL=postgresql://postgres@localhost/stravbike

# ── LLM (OpenRouter) ───────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Auth outil OpenWebUI (X-API-Key) ───────────────────────
# Clé de service statique partagée entre le backend FastAPI
# et l'outil OpenWebUI (Valves.api_key).
# Doit être identique côté OpenWebUI -> Admin -> Tools -> stravbike.
# Le frontend l'utilise aussi (injectée via Jinja2 dans base.html).
STRAVBIKE_SERVICE_KEY=

# ── OpenWebUI (proxy chat) ─────────────────────────────────
# Le frontend chat proxy vers l'API OpenWebUI (OpenAI-compatible).
# Le modèle doit avoir l'outil stravbike_tool.py rattaché.
OPENWEBUI_BASE_URL=http://localhost:8080
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=

# ── Auth JWT (legacy, non utilisé en V4 mono-utilisateur) ──
JWT_SECRET=change-me
