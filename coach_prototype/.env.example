# Only the isolated prototype DB is permitted; never use db_multi_stravbike here.
DATABASE_URL=postgresql:///coach_proto
DEMO_MODE=1
# Temporarily set to 1 for the first real signup; set to 0 immediately afterwards.
ALLOW_SIGNUP=0
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=

# Strava application credentials: store privately in .env only, never Git.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://proto.fu19.org/auth/callback
# Generate after installing requirements: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
STRAVA_TOKEN_FERNET_KEY=
