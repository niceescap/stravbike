# ── Strava OAuth (micro-app auth) ───────────────────────────
# Réutiliser les mêmes identifiants que l'app Strava existante
# (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# URL de callback externe (HTTPS via Nginx).
# Le domaine doit correspondre au "Callback Domain" configuré
# dans les paramètres de l'app Strava.
OAUTH_REDIRECT_URI=https://strava-coach.duckdns.org/auth/callback

# Répertoire de stockage des tokens (un fichier JSON par athlète)
# Chemin absolu recommandé : dans le dossier du projet sur le serveur
TOKENS_DIR=/home/nicee/stravbike/data/tokens
